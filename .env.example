# Projeto Supabase: transpo-erp (região sa-east-1)
# Dashboard: https://supabase.com/dashboard/project/tmjbzmjnqkgjwwkrxuxh

VITE_SUPABASE_URL=https://tmjbzmjnqkgjwwkrxuxh.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui-teste

# ── Deploy Cloudflare Workers (recomendado) ─────────────────────────────────
# 1. cp .env.example .env.local  (preencha a anon key)
# 2. npm run cf:login
# 3. npm run deploy
# URL provisória: https://transpo-erp.<sua-conta>.workers.dev
#
# Domínio custom: Workers → transpo-erp → Settings → Domains & Routes
#
# Supabase → Authentication → URL Configuration:
#   Site URL = URL do Worker
#   Redirect URLs = mesma URL + /login + /plataforma/login
#
# Cloudflare Workers Builds (Git conectado ao GitHub):
#   Build command: npm ci && npm run build
#   Deploy command: npx wrangler deploy
#   Build variables (obrigatório — Vite embute no bundle, não serve só runtime):
#     VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#   Após adicionar/alterar variáveis, faça um novo deploy (rebuild).

# ── Deploy EasyPanel / Docker (alternativo) ─────────────────────────────────
# Build args + runtime: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, PORT=3000
